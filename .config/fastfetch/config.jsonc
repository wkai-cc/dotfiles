{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo/cachyos/cachy_half.png",
        "type": "kitty-direct",
        "height": 20,
        "padding": { "top": 2 }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        { "type": "title" },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break",
        { "type": "os", "key": " OS:", "keyColor": "34" },
        // 使用 command 模块强制读取主板型号作为 Host
        {
            "type": "command",
            "key": "󰟀 Host:",
            "keyColor": "34",
            "text": "cat /sys/devices/virtual/dmi/id/board_name"
        },
        { "type": "kernel", "key": " Kernel:", "keyColor": "34" },
        {
            "type": "command",
            "key": " Packages:",
            "keyColor": "34",
            "text": "echo \"$(pacman -Qq | wc -l) (pacman), $(yay -Qm | wc -l) (aur)\""
        },
        { "type": "shell", "key": " Shell:", "keyColor": "34" },
        { "type": "terminal", "key": " Terminal:", "keyColor": "34" },
        { "type": "wm", "key": " WM:", "keyColor": "34" },
        {
            "type": "cpu",
            "key": " CPU:",
            "keyColor": "34",
            "format": "{1} @ {7}"
        },
        { "type": "cpuusage", "key": "󰓅 Usage:", "keyColor": "34" },
        {
            "type": "gpu",
            "key": "󰢮 GPU0:",
            "keyColor": "34",
            "format": "{2} ({6})",
            "hideType": "discrete"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU1:",
            "keyColor": "34",
            "format": "{2} ({6})",
            "hideType": "integrated"
        },
        { "type": "memory", "key": "󰑭 Memory:", "keyColor": "34", "format": "{1} / {2} ({3})" },
        { "type": "swap", "key": "󰓡 Swap:", "keyColor": "34", "format": "{1} / {2} ({3})" },
        {
            "type": "disk",
            "key": "󰋊 Disk0 (/):",
            "keyColor": "34",
            "folders": "/",
            "format": "{2} / {3} ({9})"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk0 (/data):",
            "keyColor": "34",
            "folders": "/data",
            "format": "{2} / {3} ({9})"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk1 (/mnt/data):",
            "keyColor": "34",
            "folders": "/mnt/data",
            "format": "{2} / {3} ({9})"
        },
        {
            "type": "command",
            "key": "󰄲 Root Snaps:",
            "keyColor": "34",
            "text": "snapper -c root list | grep -E '^[0-9]' | wc -l"
        },
        {
            "type": "command",
            "key": "󰄲 Home Snaps:",
            "keyColor": "34",
            "text": "snapper -c home list | grep -E '^[0-9]' | wc -l"
        },
        { "type": "uptime", "key": " Uptime:", "keyColor": "34" },
        {
            "type": "command",
            "key": "󱦟 Life:",
            "keyColor": "34",
            "text": "birth=$(stat -c %W /); [ \"$birth\" -eq 0 ] && birth=$(stat -c %X /); echo $(( ($(date +%s) - birth) / 86400 )) days"
        },
        { "type": "locale", "key": "󰗖 Locale:", "keyColor": "34" },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break"
    ]
}
