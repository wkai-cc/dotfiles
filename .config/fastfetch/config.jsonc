{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "cachyos",
        "type": "builtin",
        "padding": { "top": 2, "left": 2 }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        { "type": "title" },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break",
        { "type": "os", "key": "OS:", "keyColor": "34" },
        // 使用 command 模块强制读取主板型号作为 Host
        {
            "type": "command",
            "key": "Host:",
            "keyColor": "34",
            "text": "cat /sys/devices/virtual/dmi/id/board_name"
        },
        { "type": "kernel", "key": "Kernel:", "keyColor": "34" },
        { "type": "uptime", "key": "Uptime:", "keyColor": "34" },
        {
            "type": "command",
            "key": "Packages:",
            "keyColor": "34",
            "text": "echo \"$(pacman -Qq | wc -l) (pacman), $(yay -Qm | wc -l) (aur)\""
        },
        { "type": "shell", "key": "Shell:", "keyColor": "34" },
        { "type": "display", "key": "Display:", "keyColor": "34" },
        { "type": "de", "key": "DE:", "keyColor": "34" },
        { "type": "wm", "key": "WM:", "keyColor": "34" },
        {
            "type": "command",
            "key": "WM Theme:",
            "keyColor": "34",
            "text": "kreadconfig6 --file kwinrc --group org.kde.kdecoration2 --key theme 2>/dev/null"
        },
        { "type": "theme", "key": "Theme:", "keyColor": "34" },
        { "type": "icons", "key": "Icons:", "keyColor": "34" },
        { "type": "font", "key": "Font:", "keyColor": "34" },
        { "type": "cursor", "key": "Cursor:", "keyColor": "34" },
        { "type": "terminal", "key": "Terminal:", "keyColor": "34" },
        {
            "type": "cpu",
            "key": "CPU:",
            "keyColor": "34",
            "format": "{1} @ {7}"
        },
        { "type": "cpuusage", "key": "Usage:", "keyColor": "34" },
        {
            "type": "gpu",
            "key": "GPU0:",
            "keyColor": "34",
            "format": "{2} ({6})",
            "hideType": "discrete"
        },
        {
            "type": "gpu",
            "key": "GPU1:",
            "keyColor": "34",
            "format": "{2} ({6})",
            "hideType": "integrated"
        },
        { "type": "memory", "key": "Memory:", "keyColor": "34", "format": "{1} / {2} ({3})" },
        { "type": "swap", "key": "Swap:", "keyColor": "34", "format": "{1} / {2} ({3})" },
        {
            "type": "disk",
            "key": "Disk0 (/):",
            "keyColor": "34",
            "folders": "/"
        },
        {
            "type": "disk",
            "key": "Disk0 (/data):",
            "keyColor": "34",
            "folders": "/data"
        },
        {
            "type": "command",
            "key": "Root Snaps:",
            "keyColor": "34",
            "text": "ls /.snapshots 2>/dev/null | grep -cE '^[0-9]+$'"
        },
        {
            "type": "command",
            "key": "Local IP:",
            "keyColor": "34",
            "text": "ip -4 -o addr show wlan0 | awk '{print $4}'"
        },
        {
            "type": "command",
            "key": "Mouse Batt:",
            "keyColor": "34",
            "text": "cat /sys/class/power_supply/hidpp_battery_0/capacity 2>/dev/null | sed 's/$/%/'"
        },
        {
            "type": "command",
            "key": "Life:",
            "keyColor": "34",
            "text": "birth=$(stat -c %W /); [ \"$birth\" -eq 0 ] && birth=$(stat -c %X /); echo $(( ($(date +%s) - birth) / 86400 )) days"
        },
        { "type": "locale", "key": "Locale:", "keyColor": "34" },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break"
    ]
}
